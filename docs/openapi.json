{
  "openapi": "3.0.0",
  "info": {
    "title": "Oficina Marimb0ndo — Execution Service",
    "version": "1.0.0",
    "description": "Fila de execução, diagnóstico, reparo e estoque de peças. Participa da Saga orquestrada pelo os-service: recebe comandos via RabbitMQ (execution.commands) e publica eventos execution.* na exchange oficina.events."
  },
  "servers": [
    {
      "url": "/execucao",
      "description": "Via API Gateway (/execucao)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Execuções"
    },
    {
      "name": "Estoque"
    }
  ],
  "paths": {
    "/execucoes/fila": {
      "get": {
        "summary": "Fila de trabalho da oficina (aguardando, em diagnóstico e em reparo)",
        "description": "Ordenada por prioridade (ALTA, NORMAL, BAIXA) e ordem de chegada.",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Execuções ativas"
          },
          "403": {
            "description": "Token de cliente"
          }
        }
      }
    },
    "/execucoes": {
      "get": {
        "summary": "Lista execuções (filtros por status e OS)",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "example": "EM_FILA,EM_REPARO"
            }
          },
          {
            "in": "query",
            "name": "osId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de execuções"
          },
          "422": {
            "description": "Status inválido"
          }
        }
      }
    },
    "/execucoes/{id}": {
      "get": {
        "summary": "Detalha uma execução, com histórico de status",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Execução"
          },
          "404": {
            "description": "Não encontrada"
          }
        }
      }
    },
    "/execucoes/{id}/diagnostico": {
      "post": {
        "summary": "Inicia o diagnóstico (EM_FILA → EM_DIAGNOSTICO; OS → EM_DIAGNOSTICO)",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mechanicId": {
                    "type": "string",
                    "description": "Padrão: usuário do token"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnóstico iniciado (publica execution.DiagnosticoIniciado)"
          },
          "409": {
            "description": "Transição inválida"
          }
        }
      }
    },
    "/execucoes/{id}/reparo": {
      "post": {
        "summary": "Inicia o reparo (EM_DIAGNOSTICO → EM_REPARO; OS → EM_EXECUCAO)",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reparo iniciado (publica execution.ReparoIniciado)"
          },
          "409": {
            "description": "Transição inválida"
          }
        }
      }
    },
    "/execucoes/{id}/finalizar": {
      "post": {
        "summary": "Finaliza a execução, dá baixa nas peças e comunica o os-service (OS → FINALIZADA)",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Finalizada (publica execution.ExecucaoFinalizada)"
          },
          "409": {
            "description": "Transição inválida"
          }
        }
      }
    },
    "/execucoes/{id}/falha": {
      "post": {
        "summary": "Registra falha no reparo; peças voltam ao estoque e a Saga compensa (estorno + cancelamento)",
        "tags": [
          "Execuções"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "example": "Peça incompatível com o veículo"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Falha registrada (publica execution.ExecucaoFalhou)"
          },
          "409": {
            "description": "Transição inválida"
          },
          "422": {
            "description": "Motivo obrigatório"
          }
        }
      }
    },
    "/estoque": {
      "get": {
        "summary": "Saldo de peças (disponível e reservado para execuções ativas)",
        "tags": [
          "Estoque"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Itens de estoque"
          }
        }
      }
    },
    "/estoque/{partId}": {
      "put": {
        "summary": "Define o saldo disponível de uma peça (somente ADMIN)",
        "description": "partId é o id da peça no catálogo do os-service.",
        "tags": [
          "Estoque"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "partId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "available"
                ],
                "properties": {
                  "available": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 10
                  },
                  "description": {
                    "type": "string",
                    "example": "Pastilha de freio dianteira"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saldo atualizado"
          },
          "403": {
            "description": "Não é ADMIN"
          },
          "422": {
            "description": "Quantidade inválida"
          }
        }
      }
    }
  }
}